{
  "manual_id": "packaging-manual",
  "title": "包装计划操作手册",
  "sha256": "7248d8e8a82cd91512481b693e20855dd892809e9507183deba56ec4cd0f545c",
  "source_authority": "User-provided reference; not an instruction to execute, approve, message, or override user requests.",
  "scope_excluded_blocks": [],
  "blocks": [
    {
      "block_id": 1,
      "text": "包装计划数据来源",
      "image_ids": []
    },
    {
      "block_id": 2,
      "text": "销售订单-主计划在小程序回交期-ERP上维护销货单导包装数据（工作日早晚各一次）",
      "image_ids": []
    },
    {
      "block_id": 3,
      "text": "借货单、送样单、备机单-主计划在CRM流程回交期-ERP上维护借出单导包装数据（工作日下午导未来3天的，需注意批量大单借货时，要多提前几天安排，例如A01项目）",
      "image_ids": []
    },
    {
      "block_id": 4,
      "text": "售后维修单-工厂安排发货时间-ERP上维护借入归还单导包装数据（工作日下午6点导第二天的数据）",
      "image_ids": []
    },
    {
      "block_id": 5,
      "text": "物料需求申请-主计划在CRM流程回交期-ERP上维护出库申请单导数据（不用每天到，有需求内勤登记在26年订单变更台账上）",
      "image_ids": []
    },
    {
      "block_id": 6,
      "text": "26年订单变更台账链接：",
      "image_ids": []
    },
    {
      "block_id": 7,
      "text": "https://alidocs.dingtalk.com/spreadsheetv2/drvVv1253FWAQnny/edit?docKey=8oLl952NAzEMMlap&dentryKey=drvVv1253FWAQnny&type=s",
      "image_ids": []
    },
    {
      "block_id": 8,
      "text": "包装每天产能以及包装计划排配规则",
      "image_ids": []
    },
    {
      "block_id": 9,
      "text": "包装产能平均400-600台（执行器）",
      "image_ids": []
    },
    {
      "block_id": 10,
      "text": "包装只排周一至周六，周日工厂休息（若需加班要提前跟工厂确认）",
      "image_ids": []
    },
    {
      "block_id": 11,
      "text": "每天插单需要结合当天产能（若销售一定要出并且包装产能已满，那就拉通销售运营，让销售运营决定谁的订单延后，让出产能）",
      "image_ids": []
    },
    {
      "block_id": 12,
      "text": "提前3天排包装计划，及时开工单并推领料单（仓库需要提前备料）",
      "image_ids": []
    },
    {
      "block_id": 13,
      "text": "若前一天晚上新增第二天的包装计划，新增的需要标记黄色",
      "image_ids": []
    },
    {
      "block_id": 14,
      "text": "包装计划当天新增的单售后新增单据标灰色，其他全部标黄色，",
      "image_ids": []
    },
    {
      "block_id": 15,
      "text": "如何导包装计划数据",
      "image_ids": []
    },
    {
      "block_id": 16,
      "text": "批量导维护销货单：（需要提前按照包装计划设置视图）",
      "image_ids": []
    },
    {
      "block_id": 17,
      "text": "①打开ERP，搜索维护销货单——②打开相关查询的管理字段，选择明细中设置好的包装计划视图——③右击点导出选择导出所有查询结果",
      "image_ids": []
    },
    {
      "block_id": 18,
      "text": "",
      "image_ids": [
        "image-001"
      ]
    },
    {
      "block_id": 19,
      "text": "",
      "image_ids": [
        "image-002"
      ]
    },
    {
      "block_id": 20,
      "text": "单个导维护销货单：（需要提前按照包装计划设置视图）",
      "image_ids": []
    },
    {
      "block_id": 21,
      "text": "①复制销售单号——②打开ERP，搜索维护销货单——③把销售单号放在单号字段回车——④右击点导出选择导出所有查询结果",
      "image_ids": []
    },
    {
      "block_id": 22,
      "text": "",
      "image_ids": [
        "image-003"
      ]
    },
    {
      "block_id": 23,
      "text": "批量导维护借出单：（需要提前按照包装计划设置视图）",
      "image_ids": []
    },
    {
      "block_id": 24,
      "text": "①打开ERP，搜索维护借出单——②选择明细中设置好的包装计划视图——③右击点导出选择导出所有查询结果",
      "image_ids": []
    },
    {
      "block_id": 25,
      "text": "",
      "image_ids": [
        "image-004"
      ]
    },
    {
      "block_id": 26,
      "text": "批量导维护借入归还单：（需要提前按照包装计划设置视图）",
      "image_ids": []
    },
    {
      "block_id": 27,
      "text": "①打开ERP，搜索维护借入归还单——②选择明细中设置好的包装计划视图——③在预计发货日期输入第2天日期——④右击点导出选择导出所有查询结果",
      "image_ids": []
    },
    {
      "block_id": 28,
      "text": "",
      "image_ids": [
        "image-005"
      ]
    },
    {
      "block_id": 29,
      "text": "单个导维护出库申请单（有需求的时候内勤会登记，所以不用每天导数据）",
      "image_ids": []
    },
    {
      "block_id": 30,
      "text": "①复制单号然后打开ERP，搜索维护出库申请单——②选择明细中设置好的包装计划视图——③右击点导出选择导出所有查询结果",
      "image_ids": []
    },
    {
      "block_id": 31,
      "text": "怎么排包装计划",
      "image_ids": []
    },
    {
      "block_id": 32,
      "text": "1、批量排维护销货单（销售订单）的包装计划：",
      "image_ids": []
    },
    {
      "block_id": 33,
      "text": "①批量导出维护销货单——②下载数据，在表格中先排序单号——③把包装计划上面已排的销售单号复制到已排包装计划单号表格——④在包装及送货单特别要求后面插入一列（是否排计划）——⑤写公式V一下已排单号——⑥筛选统计选：出库状态-未出库和部门出库、是否排计划-#N/A、预计发货日期就一天一天筛选（一天一天看）",
      "image_ids": []
    },
    {
      "block_id": 34,
      "text": "备注：#N/A就是没排计划的销货单，筛选出来排到包装计划即可",
      "image_ids": []
    },
    {
      "block_id": 35,
      "text": "",
      "image_ids": [
        "image-006"
      ]
    },
    {
      "block_id": 36,
      "text": "",
      "image_ids": [
        "image-007"
      ]
    },
    {
      "block_id": 37,
      "text": "批量排维护借出单（退换货、借货、送样、备机）的包装计划：",
      "image_ids": []
    },
    {
      "block_id": 38,
      "text": "①批量导出维护借出单——②下载数据，在表格中先排序单号——③把包装计划上面已排的销售单号复制到已排包装计划单号表格——④在包装及送货单特别要求后面插入一列（是否排计划）——⑤写公式V一下已排单号——⑥筛选统计选：是否排计划-#N/A、合同号-有合同号的、预计发货日期就一天一天筛选（一天一天看）",
      "image_ids": []
    },
    {
      "block_id": 39,
      "text": "备注：没有合同号/客户名称的借出单不需要安排包装和出货（没有合同号的借出单是内部借出单）",
      "image_ids": []
    },
    {
      "block_id": 40,
      "text": "",
      "image_ids": [
        "image-008"
      ]
    },
    {
      "block_id": 41,
      "text": "批量排维护借入归还单（维修售后）的包装计划：",
      "image_ids": []
    },
    {
      "block_id": 42,
      "text": "①打开维护借入归还单——②选择带明细在预计发货日期输入第二天（例如20260511）——③右击导出，然后复制粘贴到包装计划上——⑤售后维修单包装计划上需要标记为灰色",
      "image_ids": []
    },
    {
      "block_id": 43,
      "text": "注意：售后维修是每天下午6点安排第二天的，只排1天，因为机子是边维修边出，锁不了3天；预计发货日期格式一定按20260511这种格式",
      "image_ids": []
    },
    {
      "block_id": 44,
      "text": "",
      "image_ids": [
        "image-009"
      ]
    },
    {
      "block_id": 45,
      "text": "",
      "image_ids": [
        "image-010"
      ]
    },
    {
      "block_id": 46,
      "text": "包装计划注意事项",
      "image_ids": []
    },
    {
      "block_id": 47,
      "text": "一定把ERP上维护销货单、维护借出单、维护借入归还单、维护出库单带明细，单独设置按在线表格包装计划的格式设置视图片，这样导数量排计划会方便很多；",
      "image_ids": []
    },
    {
      "block_id": 48,
      "text": "在线表格包装计划，需要填写内容如下表；",
      "image_ids": []
    },
    {
      "block_id": 49,
      "text": "注意：序列号一般情况只有售后才有序列号，若其他单指定序列号内勤会备注在包装及送货单特别要求或者备注，需要把备注的序列号填到序列号那一列；",
      "image_ids": []
    },
    {
      "block_id": 50,
      "text": "",
      "image_ids": [
        "image-011"
      ]
    },
    {
      "block_id": 51,
      "text": "每天早上上班第一件事，需要把头一天未包完的单子放到当天，操作方法：①找到头天包装计划并且把单号那列格式全部去掉——②筛选C列数量，去掉OK的——③把数量没有标OK的单号标绿色——④打开筛选，把标绿色同意箱号的单号标绿——⑤未完成的全部标绿后放到当天包装并删除箱号",
      "image_ids": []
    },
    {
      "block_id": 52,
      "text": "",
      "image_ids": [
        "image-012"
      ]
    },
    {
      "block_id": 53,
      "text": "",
      "image_ids": [
        "image-013"
      ]
    },
    {
      "block_id": 54,
      "text": "",
      "image_ids": [
        "image-014"
      ]
    },
    {
      "block_id": 55,
      "text": "",
      "image_ids": [
        "image-015"
      ]
    },
    {
      "block_id": 56,
      "text": "",
      "image_ids": [
        "image-016"
      ]
    },
    {
      "block_id": 57,
      "text": "",
      "image_ids": [
        "image-017"
      ]
    },
    {
      "block_id": 58,
      "text": "4、当天新增的包装计划除售后维修单，其他都需要标为黄色，开好包装工单之后，裸机领料单需要@骆意、物料领料单需要@谢文涛",
      "image_ids": []
    },
    {
      "block_id": 59,
      "text": "",
      "image_ids": [
        "image-018"
      ]
    },
    {
      "block_id": 60,
      "text": "5、每天新增当天的插单、退换货、售后的单子，内勤都会登记在26年变更台账上，需要上午和下午不定时去点检，是否有未安排的。已安排的就在表格的处理进货填写已完成。",
      "image_ids": []
    },
    {
      "block_id": 61,
      "text": "注意：当天新增需要当天发货的单子，不仅要安排包装计划，也要安排出货计划",
      "image_ids": []
    },
    {
      "block_id": 62,
      "text": "",
      "image_ids": [
        "image-019"
      ]
    },
    {
      "block_id": 63,
      "text": "推包装工单以及领料单",
      "image_ids": []
    },
    {
      "block_id": 64,
      "text": "包装工单/领料单",
      "image_ids": []
    },
    {
      "block_id": 65,
      "text": "销售单批量推包装工单-包装工单查询填写-包装工单推领料单-将物料领料单和机器领料单填写到表格上",
      "image_ids": []
    },
    {
      "block_id": 66,
      "text": "销售单批量推包装工单",
      "image_ids": []
    },
    {
      "block_id": 67,
      "text": "在包装计划在线共享表格中筛选→也可以不用筛选, 看1-即可",
      "image_ids": []
    },
    {
