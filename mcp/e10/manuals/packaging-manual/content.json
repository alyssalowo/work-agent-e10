      "text": "*品号供需统计表",
      "image_ids": []
    },
    {
      "block_id": 113,
      "text": "在查询包装工单时, 如果发现状态码显示已生产",
      "image_ids": []
    },
    {
      "block_id": 114,
      "text": "品号供需统计表",
      "image_ids": []
    },
